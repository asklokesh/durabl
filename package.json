{
  "name": "durabl",
  "version": "0.1.0",
  "description": "Portable agent execution journal with replay, time-travel, and logical step-level fork — built on Restate as the durable step-journal substrate.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#durabl/*": "./dist/*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp-server.d.ts",
      "import": "./dist/mcp-server.js",
      "default": "./dist/mcp-server.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "durabl": "./dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "agent",
    "durability",
    "fork",
    "hitl",
    "idempotency",
    "journal",
    "replay",
    "restate",
    "time-travel",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/asklokesh/durabl.git"
  },
  "bugs": {
    "url": "https://github.com/asklokesh/durabl/issues"
  },
  "homepage": "https://github.com/asklokesh/durabl#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "service": "node --enable-source-maps dist/service.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "gate": "npm run build && node --enable-source-maps dist/harness/run-gate.js",
    "gate:m2": "npm run build && node --enable-source-maps dist/harness/run-m2-gate.js",
    "gate:m3": "npm run build && node --enable-source-maps dist/harness/run-m3-gate.js",
    "gate:m4": "npm run build && node --enable-source-maps dist/harness/run-m4-gate.js",
    "gate:m5": "npm run build && node --enable-source-maps dist/harness/run-m5-gate.js",
    "gate:live": "npm run build && node --enable-source-maps dist/harness/run-live-providers-gate.js",
    "gate:harden": "npm run build && node --enable-source-maps dist/harness/run-harden-gate.js",
    "gate:dbos": "bash scripts/gate-dbos.sh",
    "gate:dbos-skip": "bash scripts/gate-dbos-skip.sh",
    "test:dbos": "npm run build && node --enable-source-maps --test dist/dbos-journal-source.test.js",
    "gate:hitl-ui": "npm run build && node --enable-source-maps dist/harness/run-hitl-ui-gate.js",
    "gate:hitl-web": "npm run gate:hitl-ui",
    "gate:all": "bash scripts/run-all-gates.sh",
    "cleanup:worktrees": "bash scripts/cleanup-old-worktrees.sh",
    "compose:up": "docker compose --profile docker-demo up -d",
    "compose:validate": "docker compose --profile docker-demo config",
    "demo": "npm run build && node --enable-source-maps dist/harness/demo.js",
    "smoke": "bash scripts/smoke-quickstart.sh",
    "examples:minimal": "npm run build && tsc -p examples/minimal-workflow/tsconfig.json && node --enable-source-maps examples/minimal-workflow/dist/run.js",
    "cli": "npm run build && node --enable-source-maps dist/cli.js",
    "journal:migrate": "npm run build && node --enable-source-maps dist/journal-migrate.js",
    "ui": "npm run build && node --enable-source-maps dist/cli.js ui",
    "capture:ui": "npm run build && node scripts/capture-ui.mjs",
    "test:api": "npm run build && node --enable-source-maps --test dist/http-api.test.js",
    "test": "npm run gate",
    "test:m2": "npm run gate:m2",
    "test:m3": "npm run gate:m3",
    "test:m4": "npm run gate:m4",
    "test:m5": "npm run gate:m5",
    "test:hitl-ui": "npm run gate:hitl-ui",
    "demo:interactive": "bash scripts/demo-interactive.sh",
    "test:e2e": "bash scripts/setup-e2e-artifacts.sh && npm run build && playwright test",
    "verify:npm-pack": "bash scripts/verify-npm-pack.sh"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "1.14.4",
    "@restatedev/restate-sdk-clients": "1.14.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.0",
    "@restatedev/restate": "^1.7.0",
    "@restatedev/restate-server": "^1.7.0",
    "@types/node": "^25.9.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.62.0"
  }
}
