{
  "name": "durabl",
  "version": "0.1.0",
  "description": "Portable agent execution journal with replay, time-travel, and logical step-level fork — built on Restate as the durable step-journal substrate.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "durabl": "dist/cli.js"
  },
  "files": [
    "dist",
    "web",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md"
  ],
  "keywords": [
    "agent",
    "durability",
    "fork",
    "hitl",
    "idempotency",
    "journal",
    "replay",
    "restate",
    "time-travel",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/durabl/durabl.git"
  },
  "bugs": {
    "url": "https://github.com/durabl/durabl/issues"
  },
  "homepage": "https://github.com/durabl/durabl#readme",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-web.mjs",
    "clean": "rm -rf dist *.tsbuildinfo",
    "service": "node --enable-source-maps dist/service.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gate": "npm run build && node --enable-source-maps dist/harness/run-gate.js",
    "gate:m2": "npm run build && node --enable-source-maps dist/harness/run-m2-gate.js",
    "gate:m3": "npm run build && node --enable-source-maps dist/harness/run-m3-gate.js",
    "gate:m4": "npm run build && node --enable-source-maps dist/harness/run-m4-gate.js",
    "gate:m5": "npm run build && node --enable-source-maps dist/harness/run-m5-gate.js",
    "gate:live": "npm run build && node --enable-source-maps dist/harness/run-live-providers-gate.js",
    "gate:harden": "npm run build && node --enable-source-maps dist/harness/run-harden-gate.js",
    "compose:up": "docker compose --profile docker-demo up -d",
    "demo": "npm run build && node --enable-source-maps dist/harness/demo.js",
    "cli": "npm run build && node --enable-source-maps dist/cli.js",
    "ui": "npm run build && node --enable-source-maps dist/cli.js ui",
    "capture:ui": "npm run build && node scripts/capture-ui.mjs",
    "test": "npm run gate",
    "test:m2": "npm run gate:m2",
    "test:m3": "npm run gate:m3",
    "test:m4": "npm run gate:m4",
    "test:m5": "npm run gate:m5"
  },
  "dependencies": {
    "@restatedev/restate-sdk": "1.14.4",
    "@restatedev/restate-sdk-clients": "1.14.4"
  },
  "devDependencies": {
    "@restatedev/restate": "^1.6.2",
    "@restatedev/restate-server": "^1.6.2",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
