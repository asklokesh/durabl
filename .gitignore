node_modules/
dist/
*.tsbuildinfo
.env
.env.*
*.log
.DS_Store

# Local agent-loop daemon (never commit PID or loop logs)
.agent-loop*.pid
.agent-loop*.log

# Gate-generated JSONL bundles and UI captures (regenerated by npm run gate:m3 / gate:m5 / capture:ui).
# Committed proof stays in gate-evidence.log; see docs/TEST-MATRIX.md.
docs/m3-evidence/*.jsonl
docs/m3-evidence/screenshots/
docs/m5-evidence/*.jsonl

# Committed proof: gate evidence transcripts are deliverables, not transient logs.
!docs/m1-evidence/gate-evidence.log
!docs/m2-evidence/
!docs/m2-evidence/*.log
!docs/m3-evidence/gate-evidence.log
!docs/m4-evidence/
!docs/m4-evidence/**
.gstack/
