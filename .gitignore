node_modules/
dist/
*.tsbuildinfo
.env
.env.*
!.env.example
*.log
.DS_Store

# Local agent-loop daemon (never commit PID or loop logs)
*.pid
.agent-loop*.log

# Gate-generated JSONL bundles and UI captures (stable copies live in test/fixtures/).
