# durabl environment template — copy to .env and adjust.
# No secrets here: placeholders and comments only.
# Provider API keys are separate (OPENAI_API_KEY, ANTHROPIC_API_KEY, OPENROUTER_API_KEY); never commit those.

# ── Data & persistence ───────────────────────────────────────────────────────
# Root directory for journal, effects, and Restate local data (default: $TMPDIR/durabl-m1).
# DURABL_DATA_DIR=/tmp/durabl-m1

# Override individual SQLite paths (defaults under DURABL_DATA_DIR).
# DURABL_JOURNAL_DB=/tmp/durabl-m1/journal.db
# DURABL_EFFECT_DB=/tmp/durabl-m1/effects.db

# Restate server on-disk state (local-binary target; default: <DURABL_DATA_DIR>/restate-data).
# DURABL_RESTATE_DATA_DIR=/tmp/durabl-m1/restate-data

# Journal backend: live (default) or dbos (requires DBOS_DATABASE_URL).
# DURABL_JOURNAL_SOURCE=live

# ── Deploy target (config-only switch: local | docker | external) ─────────────
# DURABL_DEPLOY_TARGET=local

# SDK service port Restate dials (local / external targets).
# DURABL_SERVICE_PORT=9080

# Restate ingress & admin (local / external; also override managed/cloud endpoints).
# DURABL_RESTATE_INGRESS=http://localhost:8080
# DURABL_RESTATE_ADMIN=http://localhost:9070

# Docker target — distinct ports so containerized Restate can run beside local binary.
# DURABL_DOCKER_INGRESS_PORT=8081
# DURABL_DOCKER_ADMIN_PORT=9071
# DURABL_DOCKER_SERVICE_PORT=9081
# DURABL_DOCKER_RESTATE_INGRESS=http://localhost:8081
# DURABL_DOCKER_RESTATE_ADMIN=http://localhost:9071
# DURABL_DOCKER_IMAGE=restatedev/restate:1.6
# DURABL_DOCKER_CONTAINER=durabl-m4-restate

# Set to 1 when starting the Restate SDK service directly (node dist/service.js).
# DURABL_SERVE=1

# ── Model providers (DURABL_MODEL_PROVIDER — no code change to switch) ─────────
# fake-echo | fake-upper | openai | anthropic | openrouter
# DURABL_MODEL_PROVIDER=fake-echo

# Model ids when using real providers (keys: OPENAI_API_KEY / ANTHROPIC_API_KEY / OPENROUTER_API_KEY).
# DURABL_OPENAI_MODEL=gpt-4o-mini
# DURABL_ANTHROPIC_MODEL=claude-3-5-haiku-latest
# DURABL_OPENROUTER_MODEL=openai/gpt-oss-120b:free

# OpenRouter base URL (OpenAI-compatible; default https://openrouter.ai/api/v1).
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# HTTP provider retry / timeout (see docs/HARDENING.md).
# DURABL_PROVIDER_TIMEOUT_MS=30000
# DURABL_PROVIDER_MAX_ATTEMPTS=3
# DURABL_PROVIDER_RETRY_BACKOFF_MS=500

# ── Replay UI ─────────────────────────────────────────────────────────────────
# DURABL_UI_HOST=127.0.0.1
# DURABL_UI_PORT=7878

# ── Harness / gates only (adversarial crash injection; not for production) ────
# DURABL_CRASH_AT=
# DURABL_CRASH_ONCE=1
# DURABL_CRASH_MARKER_DIR=/tmp/durabl-m1/markers
# DURABL_HARNESS_LOCK=/tmp/durabl-harness.lock
