{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "baseUrl": ".",
    "paths": {
      "#durabl/*": ["../../dist/*"]
    },
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true
  },
  "include": [
    "*.ts"
  ]
}
